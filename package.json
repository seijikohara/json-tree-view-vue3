{
  "name": "json-tree-view-vue3",
  "version": "2.0.0",
  "description": "JSON tree rendering Vue3 component",
  "keywords": [
    "json",
    "tree",
    "vue3"
  ],
  "homepage": "https://github.com/seijikohara/json-tree-view-vue3#readme",
  "bugs": {
    "url": "https://github.com/seijikohara/json-tree-view-vue3/issues"
  },
  "license": "MIT",
  "author": "Seiji Kohara <sage.0118@gmail.com> (https://github.com/seijikohara)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seijikohara/json-tree-view-vue3.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/json-tree-view-vue3.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/json-tree-view-vue3.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "lint": "oxlint . && eslint \"**/*.vue\"",
    "lint:fix": "oxlint . --fix && eslint \"**/*.vue\" --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "deps:update": "taze -w && pnpm install",
    "deps:check": "taze",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vue/language-core": "^3.3.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.6.0",
    "eslint-plugin-oxlint": "^1.73.0",
    "eslint-plugin-vue": "^10.9.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.61.1",
    "publint": "^0.3.21",
    "sass": "^1.94.2",
    "taze": "^19.14.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.11.0"
}

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ['github>seijikohara/renovate-config:default.json5'],
  packageRules: [
    {
      description: 'Hold TypeScript at 6.x: vue-tsc and unplugin-dts need the TypeScript JS API that TypeScript 7.0 does not ship. Remove this rule once TypeScript 7.1 is stable and vue-tsc supports it through content mappers, or golar reaches 1.0.',
      matchPackageNames: ['typescript'],
      allowedVersions: '<7'
    },
    {
      description: 'Group the Vue framework and its tooling',
      groupName: 'vue',
      matchPackageNames: ['vue', 'vue-tsc', '@vue/*', '@vitejs/plugin-vue']
    },
    {
      description: 'Group the build toolchain',
      groupName: 'build toolchain',
      matchPackageNames: [
        'vite',
        'vite-plugin-*',
        'unplugin-dts',
        'typescript',
        '@microsoft/api-extractor',
        '@vue/language-core'
      ]
    },
    {
      // oxlint declares the oxlint-tsgolint version it needs as a peer dependency,
      // and oxlint-tsgolint moves to a new major with TypeScript. Keep majors in the
      // same PR so oxlint never lands without a matching oxlint-tsgolint.
      description: 'Group the oxc linting and formatting toolchain',
      groupName: 'linting and formatting',
      matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint'],
      separateMajorMinor: false
    },
    {
      description: 'Group the test toolchain',
      groupName: 'testing',
      matchPackageNames: ['vitest', '@vitest/*', 'vitest-browser-vue', 'playwright']
    },
    {
      description: 'Group TypeScript type definitions',
      groupName: 'type definitions',
      matchPackageNames: ['@types/*']
    }
  ]
}

{
  "name": "json-tree-view-vue3",
  "version": "2.0.0",
  "description": "JSON tree rendering Vue3 component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seijikohara/json-tree-view-vue3.git"
  },
  "keywords": [
    "vue3",
    "json",
    "tree"
  ],
  "author": "Seiji Kohara <sage.0118@gmail.com> (https://github.com/seijikohara)",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  },
  "bugs": {
    "url": "https://github.com/seijikohara/json-tree-view-vue3/issues"
  },
  "homepage": "https://github.com/seijikohara/json-tree-view-vue3#readme",
  "type": "module",
  "main": "./dist/json-tree-view-vue3.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/json-tree-view-vue3.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "deps:update": "taze -w && pnpm install",
    "deps:check": "taze",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/language-core": "^3.3.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.0.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "publint": "^0.3.21",
    "sass": "^1.94.2",
    "taze": "^19.14.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  }
}
